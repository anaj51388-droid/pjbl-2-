<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Klasifikasi Data dengan Himpunan - Proyek Mini #2 Pertemuan 6</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['Fira Code', 'monospace'],
                    },
                    colors: {
                        navy: {
                            800: '#1e293b',
                            900: '#0f172a',
                            950: '#020617',
                        },
                        slate: {
                            850: '#1e293b',
                        },
                        brand: {
                            accent: '#38bdf8',
                            purple: '#a855f7',
                            emerald: '#10b981',
                            amber: '#f59e0b',
                            rose: '#f43f5e'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        .venn-circle {
            mix-blend-mode: multiply;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
        }
        .venn-circle:hover {
            fill-opacity: 0.6;
            filter: drop-shadow(0 0 8px rgba(56, 189, 248, 0.5));
        }
        .venn-text {
            font-family: 'Inter', sans-serif;
            pointer-events: none;
            user-select: none;
        }
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0f172a;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #475569;
        }
    </style>
</head>
<body class="bg-navy-950 text-slate-100 font-sans min-h-screen flex flex-col antialiased">

    <!-- Header / Navbar -->
    <header class="bg-navy-900/80 backdrop-blur-md border-b border-slate-800 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-sky-500 to-indigo-600 flex items-center justify-center shadow-lg shadow-sky-500/20">
                    <i class="fa-solid fa-diagram-project text-white text-lg"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg text-white leading-tight">Klasifikasi Data Himpunan</h1>
                    <p class="text-xs text-slate-400">Proyek Mini #2 • Pertemuan 6</p>
                </div>
            </div>
            
            <div class="flex items-center space-x-3">
                <div class="hidden sm:flex items-center space-x-2 bg-navy-800 border border-slate-700/60 px-3 py-1.5 rounded-lg text-xs text-slate-300">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span>Status: Engine Ready</span>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 grid grid-cols-1 lg:grid-cols-12 gap-6">

        <!-- LEFT PANEL -->
        <section class="lg:col-span-5 space-y-6">
            <div class="bg-navy-900 border border-slate-800 rounded-2xl p-5 shadow-xl">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-sm font-semibold text-slate-200 uppercase tracking-wider flex items-center gap-2">
                        <i class="fa-solid fa-database text-sky-400"></i> Preset Dataset Contoh
                    </h2>
                    <span class="text-xs text-slate-400">Pilih Preset</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <button onclick="loadDataset(1)" class="group text-left p-3 rounded-xl bg-navy-800/60 hover:bg-navy-800 border border-slate-700/60 hover:border-sky-500/50 transition duration-200 flex flex-col justify-between">
                        <div>
                            <div class="text-xs font-semibold text-sky-400">Dataset 1</div>
                            <div class="text-sm font-bold text-slate-100">Skillsets IT</div>
                            <div class="text-xs text-slate-400 mt-1">3 Himpunan (Python, SQL, Web)</div>
                        </div>
                    </button>
                    <button onclick="loadDataset(2)" class="group text-left p-3 rounded-xl bg-navy-800/60 hover:bg-navy-800 border border-slate-700/60 hover:border-purple-500/50 transition duration-200 flex flex-col justify-between">
                        <div>
                            <div class="text-xs font-semibold text-purple-400">Dataset 2</div>
                            <div class="text-sm font-bold text-slate-100">E-Commerce</div>
                            <div class="text-xs text-slate-400 mt-1">2 Himpunan (Elektronik, Fashion)</div>
                        </div>
                    </button>
                </div>
            </div>

            <!-- Set Input Form -->
            <div class="bg-navy-900 border border-slate-800 rounded-2xl p-5 shadow-xl space-y-4">
                <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                    <h2 class="text-sm font-semibold text-slate-200 uppercase tracking-wider flex items-center gap-2">
                        <i class="fa-solid fa-sliders text-indigo-400"></i> Input Elemen Himpunan
                    </h2>
                    <button onclick="clearInputs()" class="text-xs text-slate-400 hover:text-rose-400 transition flex items-center gap-1">
                        <i class="fa-solid fa-rotate-left"></i> Reset
                    </button>
                </div>

                <div class="space-y-3">
                    <div>
                        <label class="block text-xs font-medium text-slate-300 mb-1">Himpunan Semesta (U)</label>
                        <input type="text" id="inputU" placeholder="Andi, Budi, Cici..." class="w-full bg-navy-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 font-mono">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-sky-400 mb-1">Himpunan A</label>
                        <input type="text" id="inputA" placeholder="Andi, Budi..." class="w-full bg-navy-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 font-mono">
                        <input type="hidden" id="labelA" value="Set A">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-purple-400 mb-1">Himpunan B</label>
                        <input type="text" id="inputB" placeholder="Cici, Dini..." class="w-full bg-navy-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 font-mono">
                        <input type="hidden" id="labelB" value="Set B">
                    </div>
                    <div>
                        <div class="flex items-center justify-between mb-1">
                            <label class="text-xs font-medium text-amber-400">Himpunan C</label>
                            <label class="inline-flex items-center cursor-pointer">
                                <input type="checkbox" id="toggleC" checked onchange="handleToggleC()" class="sr-only peer">
                                <div class="w-7 h-4 bg-slate-700 rounded-full peer peer-checked:after:translate-x-full after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:bg-amber-500 relative"></div>
                            </label>
                        </div>
                        <input type="text" id="inputC" placeholder="Dini, Eko..." class="w-full bg-navy-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 font-mono">
                        <input type="hidden" id="labelC" value="Set C">
                    </div>
                </div>

                <button onclick="calculateAndRender()" class="w-full py-2.5 rounded-xl bg-gradient-to-r from-sky-500 to-indigo-600 text-white font-semibold text-sm shadow-lg shadow-sky-500/25 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-calculator"></i> Proses & Visualisasikan
                </button>
            </div>
        </section>

        <!-- RIGHT PANEL -->
        <section class="lg:col-span-7 space-y-6">
            <div class="bg-navy-900 border border-slate-800 rounded-2xl p-5 shadow-xl relative overflow-hidden">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-sm font-semibold text-slate-200 uppercase tracking-wider flex items-center gap-2">
                        <i class="fa-solid fa-circle-nodes text-sky-400"></i> Visualisasi Diagram Venn
                    </h2>
                </div>
                <div class="w-full flex justify-center items-center bg-navy-950/60 rounded-xl p-4 border border-slate-800/80 min-h-[300px] relative">
                    <svg id="vennSvg" viewBox="0 0 500 360" class="w-full max-w-[480px] h-auto"></svg>
                </div>
            </div>

            <!-- Results Table -->
            <div class="bg-navy-900 border border-slate-800 rounded-2xl p-5 shadow-xl space-y-4">
                <h2 class="text-sm font-semibold text-slate-200 uppercase tracking-wider flex items-center gap-2">
                    <i class="fa-solid fa-list-check text-emerald-400"></i> Hasil Operasi Himpunan
                </h2>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs border-collapse">
                        <thead>
                            <tr class="border-b border-slate-800 text-slate-400 uppercase font-mono">
                                <th class="py-2 px-3">Operasi</th>
                                <th class="py-2 px-3">Notasi</th>
                                <th class="py-2 px-3">Anggota Elemen</th>
                                <th class="py-2 px-3 text-right">Kardinalitas</th>
                            </tr>
                        </thead>
                        <tbody id="resultsTableBody" class="divide-y divide-slate-800/60 font-mono text-slate-200"></tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>

    <!-- JavaScript Engine -->
    <script>
        let setU = new Set(), setA = new Set(), setB = new Set(), setC = new Set();
        let isCActive = true;

        window.onload = function() { loadDataset(1); };

        function handleToggleC() {
            isCActive = document.getElementById('toggleC').checked;
            document.getElementById('inputC').disabled = !isCActive;
            calculateAndRender();
        }

        function parseSetInput(id) {
            const val = document.getElementById(id).value;
            if (!val.trim()) return new Set();
            return new Set(val.split(',').map(s => s.trim()).filter(s => s.length > 0));
        }

        function loadDataset(presetId) {
            if (presetId === 1) {
                document.getElementById('inputU').value = "Andi, Budi, Cici, Dini, Eko, Fani, Gita, Hadi";
                document.getElementById('inputA').value = "Andi, Budi, Cici, Dini, Eko";
                document.getElementById('inputB').value = "Cici, Dini, Eko, Fani, Gita";
                document.getElementById('inputC').value = "Dini, Eko, Fani, Hadi";
                document.getElementById('toggleC').checked = true;
                handleToggleC();
            } else {
                document.getElementById('inputU').value = "P1, P2, P3, P4, P5, P6, P7, P8, P9, P10";
                document.getElementById('inputA').value = "P1, P2, P3, P4, P5";
                document.getElementById('inputB').value = "P4, P5, P6, P7, P8";
                document.getElementById('inputC').value = "";
                document.getElementById('toggleC').checked = false;
                handleToggleC();
            }
        }

        function clearInputs() {
            ['inputU', 'inputA', 'inputB', 'inputC'].forEach(id => document.getElementById(id).value = "");
            calculateAndRender();
        }

        function union(s1, s2) { return new Set([...s1, ...s2]); }
        function intersect(s1, s2) { return new Set([...s1].filter(x => s2.has(x))); }
        function difference(s1, s2) { return new Set([...s1].filter(x => !s2.has(x))); }
        function complement(s1, univ) { return new Set([...univ].filter(x => !s1.has(x))); }

        function calculateAndRender() {
            setU = parseSetInput('inputU');
            setA = parseSetInput('inputA');
            setB = parseSetInput('inputB');
            setC = isCActive ? parseSetInput('inputC') : new Set();

            new Set([...setA, ...setB, ...setC]).forEach(item => setU.add(item));

            renderTableResults();
            renderVennDiagram();
        }

        function formatSetOutput(s) {
            return s.size === 0 ? "∅" : `{ ${Array.from(s).join(', ')} }`;
        }

        function renderTableResults() {
            const tbody = document.getElementById('resultsTableBody');
            tbody.innerHTML = "";
            let rows = !isCActive ? [
                { name: "Union (A ∪ B)", expr: "A ∪ B", data: union(setA, setB) },
                { name: "Intersection (A ∩ B)", expr: "A ∩ B", data: intersect(setA, setB) },
                { name: "Difference (A − B)", expr: "A − B", data: difference(setA, setB) }
            ] : [
                { name: "Union Semua", expr: "A ∪ B ∪ C", data: union(union(setA, setB), setC) },
                { name: "Irisan Ketiganya", expr: "A ∩ B ∩ C", data: intersect(intersect(setA, setB), setC) }
            ];

            rows.forEach(r => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="py-2.5 px-3">${r.name}</td>
                    <td class="py-2.5 px-3 text-sky-400">${r.expr}</td>
                    <td class="py-2.5 px-3 text-slate-300">${formatSetOutput(r.data)}</td>
                    <td class="py-2.5 px-3 text-right font-bold text-emerald-400">${r.data.size}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        function renderVennDiagram() {
            const svg = document.getElementById('vennSvg');
            svg.innerHTML = `
                <rect x="10" y="10" width="480" height="340" rx="16" fill="none" stroke="#334155" stroke-width="2" stroke-dasharray="4 4" />
                <text x="25" y="35" fill="#94a3b8" font-size="12" font-weight="bold">Semesta (U) - Total: ${setU.size}</text>
            `;
            if (!isCActive) {
                svg.innerHTML += `
                    <circle cx="190" cy="170" r="105" fill="#0284c7" fill-opacity="0.35" stroke="#38bdf8" stroke-width="3" />
                    <circle cx="310" cy="170" r="105" fill="#9333ea" fill-opacity="0.35" stroke="#c084fc" stroke-width="3" />
                `;
            } else {
                svg.innerHTML += `
                    <circle cx="190" cy="145" r="90" fill="#0284c7" fill-opacity="0.3" stroke="#38bdf8" stroke-width="2.5" />
                    <circle cx="310" cy="145" r="90" fill="#9333ea" fill-opacity="0.3" stroke="#c084fc" stroke-width="2.5" />
                    <circle cx="250" cy="225" r="90" fill="#d97706" fill-opacity="0.3" stroke="#fbbf24" stroke-width="2.5" />
                `;
            }
        }
    </script>
</body>
</html>
