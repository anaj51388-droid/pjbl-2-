<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Visualisator Himpunan & Prinsip Inklusi-Eksklusi</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome untuk Ikon -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Fira+Code:wght@400;600&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['Fira Code', 'monospace'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f7ff',
                            100: '#e0effe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        .venn-circle {
            transition: all 0.3s ease;
            mix-blend-mode: multiply;
        }
        .venn-region {
            transition: all 0.25s ease;
            cursor: pointer;
        }
        .venn-region:hover {
            filter: brightness(0.9) drop-shadow(0 0 6px rgba(0,0,0,0.2));
        }
        .active-region {
            stroke: #1e293b;
            stroke-width: 3px;
            filter: drop-shadow(0 0 8px rgba(59, 130, 246, 0.5));
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col">

    <!-- Header / Navbar Demo Mode -->
    <header class="bg-indigo-900 text-white shadow-lg sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex flex-wrap justify-between items-center gap-4">
            <div class="flex items-center space-x-3">
                <div class="bg-indigo-600 p-2.5 rounded-xl shadow-md">
                    <i class="fa-solid fa-diagram-project text-xl text-white"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight">Visualisator Teori Himpunan & PIE</h1>
                    <p class="text-xs text-indigo-200">Aplikasi Demonstrasi Tugas Kuliah Teori Himpunan</p>
                </div>
            </div>
            
            <!-- Presentasi Mode / Quick Controls -->
            <div class="flex items-center gap-2">
                <span class="text-xs font-medium text-indigo-200 hidden md:inline">Preset Contoh Data:</span>
                <button onclick="loadPreset(1)" class="bg-indigo-800 hover:bg-indigo-700 text-white text-xs px-3 py-1.5 rounded-lg border border-indigo-600 transition flex items-center gap-1.5 shadow-sm">
                    <i class="fa-solid fa-[#1] text-amber-400"></i>
                    <span>Dataset 1: Skill Mahasiswa</span>
                </button>
                <button onclick="loadPreset(2)" class="bg-indigo-800 hover:bg-indigo-700 text-white text-xs px-3 py-1.5 rounded-lg border border-indigo-600 transition flex items-center gap-1.5 shadow-sm">
                    <i class="fa-solid fa-[#2] text-emerald-400"></i>
                    <span>Dataset 2: Hobi Olahraga</span>
                </button>
                <button onclick="loadPreset(3)" class="bg-indigo-800 hover:bg-indigo-700 text-white text-xs px-3 py-1.5 rounded-lg border border-indigo-600 transition flex items-center gap-1.5 shadow-sm">
                    <i class="fa-solid fa-[#3] text-purple-400"></i>
                    <span>Dataset 3: Ketersediaan Modul</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Content Utama -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

        <!-- Grid Input & Controls -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            
            <!-- Panel Input Data (4 cols) -->
            <section class="lg:col-span-4 bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-4 border-b pb-3">
                        <h2 class="font-semibold text-slate-800 text-base flex items-center gap-2">
                            <i class="fa-solid fa-pen-to-square text-indigo-600"></i>
                            Input Himpunan Data
                        </h2>
                        <button onclick="resetData()" class="text-xs text-rose-600 hover:text-rose-800 font-medium transition flex items-center gap-1">
                            <i class="fa-solid fa-rotate-left"></i> Reset
                        </button>
                    </div>

                    <div class="space-y-4 text-xs">
                        <!-- Himpunan Semesta U -->
                        <div>
                            <label class="block font-medium text-slate-700 mb-1">Himpunan Semesta (U) <span class="text-slate-400 font-normal">(Pisahkan dengan koma)</span></label>
                            <textarea id="inputU" rows="2" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 font-mono text-slate-800 transition" placeholder="Budi, Andi, Cici, Doni, Eka, Fani, Gina, Hadi"></textarea>
                        </div>

                        <!-- Himpunan A -->
                        <div>
                            <div class="flex justify-between items-center mb-1">
                                <label class="font-medium text-blue-700">Himpunan A</label>
                                <input type="text" id="labelA" value="Programming" class="text-right border-b border-blue-300 focus:outline-none font-semibold text-blue-700 text-xs w-32 bg-transparent" placeholder="Nama Set A">
                            </div>
                            <textarea id="inputA" rows="2" class="w-full px-3 py-2 border border-blue-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 font-mono text-slate-800 bg-blue-50/30 transition" placeholder="Budi, Andi, Cici, Doni"></textarea>
                        </div>

                        <!-- Himpunan B -->
                        <div>
                            <div class="flex justify-between items-center mb-1">
                                <label class="font-medium text-rose-700">Himpunan B</label>
                                <input type="text" id="labelB" value="Desain Grafis" class="text-right border-b border-rose-300 focus:outline-none font-semibold text-rose-700 text-xs w-32 bg-transparent" placeholder="Nama Set B">
                            </div>
                            <textarea id="inputB" rows="2" class="w-full px-3 py-2 border border-rose-200 rounded-lg focus:ring-2 focus:ring-rose-500 focus:border-rose-500 font-mono text-slate-800 bg-rose-50/30 transition" placeholder="Cici, Doni, Eka, Fani"></textarea>
                        </div>
                    </div>
                </div>

                <div class="mt-5 pt-3 border-t">
                    <button onclick="processData()" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2.5 px-4 rounded-xl shadow transition duration-150 flex items-center justify-center gap-2 text-sm">
                        <i class="fa-solid fa-calculator"></i>
                        <span>Hitung & Visualisasikan</span>
                    </button>
                </div>
            </section>

            <!-- Panel Visualisasi Diagram Venn (8 cols) -->
            <section class="lg:col-span-8 bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex flex-col">
                <div class="flex flex-wrap items-center justify-between gap-2 mb-3 border-b pb-3">
                    <div>
                        <h2 class="font-semibold text-slate-800 text-base flex items-center gap-2">
                            <i class="fa-solid fa-shapes text-indigo-600"></i>
                            Diagram Venn Otomatis
                        </h2>
                        <p class="text-xs text-slate-500">Klik tombol operasi atau area pada diagram untuk melihat area terkait</p>
                    </div>
                    <div id="activeOpBadge" class="bg-indigo-100 text-indigo-800 text-xs font-semibold px-3 py-1 rounded-full border border-indigo-200">
                        Sorotan: <span id="activeOpText">Semua Area</span>
                    </div>
                </div>

                <!-- Canvas Visualisasi Venn SVG -->
                <div class="relative flex-1 bg-slate-50 rounded-xl border border-slate-200 p-4 flex items-center justify-center min-h-[300px]">
                    <svg id="vennSvg" viewBox="0 0 500 300" class="w-full max-w-lg h-auto select-none">
                        <defs>
                            <!-- Filter Bayangan -->
                            <filter id="shadow" x="-5%" y="-5%" width="110%" height="110%">
                                <feDropShadow dx="0" dy="2" stdDeviation="3" flood-opacity="0.1"/>
                            </filter>
                        </defs>

                        <!-- Box Himpunan Semesta U -->
                        <rect x="10" y="10" width="480" height="280" rx="12" fill="#ffffff" stroke="#94a3b8" stroke-width="2" stroke-dasharray="4 4"/>
                        <text x="25" y="35" class="text-xs font-bold fill-slate-500">U (Semesta)</text>
                        <!-- Elemen luar U (Complement of A union B) -->
                        <text id="vennTextU" x="30" y="60" class="text-[10px] font-mono fill-slate-500" width="100"></text>

                        <!-- Area Himpunan A saja (Difference A - B) -->
                        <path id="regionAonly" class="venn-region fill-blue-500/20 hover:fill-blue-500/40" 
                              d="M 195 70 A 90 90 0 1 0 195 230 A 90 90 0 0 1 195 70 Z" 
                              onclick="selectOperation('A_minus_B')"/>

                        <!-- Area Irisan (Intersection A ∩ B) -->
                        <path id="regionIntersect" class="venn-region fill-purple-500/30 hover:fill-purple-500/50" 
                              d="M 195 70 A 90 90 0 0 1 305 70 A 90 90 0 0 1 195 230 A 90 90 0 0 1 195 70 Z" 
                              onclick="selectOperation('intersection')"/>

                        <!-- Area Himpunan B saja (Difference B - A) -->
                        <path id="regionBonly" class="venn-region fill-rose-500/20 hover:fill-rose-500/40" 
                              d="M 305 70 A 90 90 0 1 1 305 230 A 90 90 0 0 1 305 70 Z" 
                              onclick="selectOperation('B_minus_A')"/>

                        <!-- Lingkaran Outlines -->
                        <circle id="circleA" cx="195" cy="150" r="90" fill="none" stroke="#3b82f6" stroke-width="2.5"/>
                        <circle id="circleB" cx="305" cy="150" r="90" fill="none" stroke="#f43f5e" stroke-width="2.5"/>

                        <!-- Label Lingkaran -->
                        <text id="svgLabelA" x="140" y="45" class="text-xs font-bold fill-blue-700 text-anchor-middle">A</text>
                        <text id="svgLabelB" x="360" y="45" class="text-xs font-bold fill-rose-700 text-anchor-middle">B</text>

                        <!-- Teks Elemen dalam Diagram -->
                        <!-- Teks A Saja -->
                        <foreignObject x="115" y="90" width="80" height="120">
                            <div id="vennTextA" class="text-[10px] font-mono text-blue-900 overflow-hidden text-center break-words leading-tight p-1"></div>
                        </foreignObject>

                        <!-- Teks Irisan -->
                        <foreignObject x="210" y="90" width="80" height="120">
                            <div id="vennTextAB" class="text-[10px] font-mono text-purple-950 font-semibold overflow-hidden text-center break-words leading-tight p-1"></div>
                        </foreignObject>

                        <!-- Teks B Saja -->
                        <foreignObject x="305" y="90" width="80" height="120">
                            <div id="vennTextB" class="text-[10px] font-mono text-rose-900 overflow-hidden text-center break-words leading-tight p-1"></div>
                        </foreignObject>
                    </svg>
                </div>

                <!-- Selektor Operasi Cepat -->
                <div class="mt-4 flex flex-wrap gap-1.5 justify-center text-xs">
                    <button onclick="selectOperation('union')" class="op-btn bg-slate-100 hover:bg-slate-200 text-slate-700 px-2.5 py-1.5 rounded-lg border transition font-mono">A ∪ B</button>
                    <button onclick="selectOperation('intersection')" class="op-btn bg-slate-100 hover:bg-slate-200 text-slate-700 px-2.5 py-1.5 rounded-lg border transition font-mono">A ∩ B</button>
                    <button onclick="selectOperation('A_minus_B')" class="op-btn bg-slate-100 hover:bg-slate-200 text-slate-700 px-2.5 py-1.5 rounded-lg border transition font-mono">A − B</button>
                    <button onclick="selectOperation('B_minus_A')" class="op-btn bg-slate-100 hover:bg-slate-200 text-slate-700 px-2.5 py-1.5 rounded-lg border transition font-mono">B − A</button>
                    <button onclick="selectOperation('sym_diff')" class="op-btn bg-slate-100 hover:bg-slate-200 text-slate-700 px-2.5 py-1.5 rounded-lg border transition font-mono">A Δ B</button>
                    <button onclick="selectOperation('compl_A')" class="op-btn bg-slate-100 hover:bg-slate-200 text-slate-700 px-2.5 py-1.5 rounded-lg border transition font-mono">A'</button>
                    <button onclick="selectOperation('compl_B')" class="op-btn bg-slate-100 hover:bg-slate-200 text-slate-700 px-2.5 py-1.5 rounded-lg border transition font-mono">B'</button>
                    <button onclick="selectOperation('reset')" class="bg-indigo-50 hover:bg-indigo-100 text-indigo-700 px-2.5 py-1.5 rounded-lg border border-indigo-200 transition font-sans font-medium">Tampilkan Semua</button>
                </div>
            </section>
        </div>

        <!-- Grid Hasil Operasi Himpunan & Prinsip Inklusi-Eksklusi -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

            <!-- Tab / Tabel Hasil Operasi Lengkap (7 cols) -->
            <section class="lg:col-span-7 bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
                <div class="border-b pb-3 mb-4 flex justify-between items-center">
                    <h2 class="font-semibold text-slate-800 text-base flex items-center gap-2">
                        <i class="fa-solid fa-list-check text-indigo-600"></i>
                        Hasil Operasi Himpunan Lengkap
                    </h2>
                    <span id="cardinalitySummary" class="text-xs bg-slate-100 text-slate-600 px-2.5 py-1 rounded-md font-mono">|U| = 0</span>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-xs text-left">
                        <thead class="bg-slate-50 text-slate-500 uppercase font-semibold border-b">
                            <tr>
                                <th class="py-2.5 px-3">Operasi</th>
                                <th class="py-2.5 px-3">Notasi Simbol</th>
                                <th class="py-2.5 px-3">Hasil Anggota (Set)</th>
                                <th class="py-2.5 px-3 text-center">Kardinalitas</th>
                            </tr>
                        </thead>
                        <tbody id="operationsTableBody" class="divide-y divide-slate-100 font-mono">
                            <!-- Diisi secara dinamis oleh JS -->
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Breakdown Prinsip Inklusi Eksklusi (PIE) (5 cols) -->
            <section class="lg:col-span-5 bg-gradient-to-br from-indigo-900 to-slate-900 text-white p-5 rounded-2xl shadow-md flex flex-col justify-between">
                <div>
                    <div class="border-b border-indigo-800 pb-3 mb-4 flex items-center justify-between">
                        <h2 class="font-semibold text-base text-indigo-100 flex items-center gap-2">
                            <i class="fa-solid fa-square-root-variable text-amber-400"></i>
                            Prinsip Inklusi-Eksklusi (PIE)
                        </h2>
                        <span class="text-[10px] bg-amber-500/20 text-amber-300 border border-amber-500/30 px-2 py-0.5 rounded">Rumus 2 Himpunan</span>
                    </div>

                    <!-- Formula Display -->
                    <div class="bg-indigo-950/60 p-3 rounded-xl border border-indigo-800/60 mb-4 text-center">
                        <p class="text-xs text-indigo-300 mb-1">Rumus Dasar Kardinalitas Gabungan:</p>
                        <p class="font-mono text-sm sm:text-base font-bold text-amber-300 tracking-wide">
                            |A ∪ B| = |A| + |B| − |A ∩ B|
                        </p>
                    </div>

                    <!-- Step-by-Step Calculation -->
                    <div class="space-y-2.5 text-xs font-mono">
                        <div class="flex justify-between items-center bg-indigo-800/30 p-2 rounded-lg border border-indigo-700/30">
                            <span class="text-indigo-200">1. |A| (Kardinalitas A)</span>
                            <span id="pieCardA" class="font-bold text-blue-300">0</span>
                        </div>
                        <div class="flex justify-between items-center bg-indigo-800/30 p-2 rounded-lg border border-indigo-700/30">
                            <span class="text-indigo-200">2. |B| (Kardinalitas B)</span>
                            <span id="pieCardB" class="font-bold text-rose-300">0</span>
                        </div>
                        <div class="flex justify-between items-center bg-indigo-800/30 p-2 rounded-lg border border-indigo-700/30">
                            <span class="text-indigo-200">3. |A ∩ B| (Irisan Dihitung 2x)</span>
                            <span id="pieCardIntersect" class="font-bold text-purple-300">0</span>
                        </div>

                        <div class="pt-2 border-t border-indigo-800/80">
                            <p class="text-indigo-300 text-[11px] mb-1 font-sans">Perhitungan Substitusi:</p>
                            <div id="pieStepSubstitution" class="bg-slate-950/80 p-2.5 rounded-lg border border-indigo-500/30 text-amber-200 text-xs">
                                |A ∪ B| = 0 + 0 - 0 = 0
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Verification Box -->
                <div class="mt-4 pt-3 border-t border-indigo-800 flex items-center justify-between text-xs">
                    <span class="text-indigo-300">Status Verifikasi PIE:</span>
                    <span id="pieStatusBadge" class="bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-2.5 py-1 rounded-full font-semibold flex items-center gap-1">
                        <i class="fa-solid fa-circle-check"></i> Sesuai & Valid
                    </span>
                </div>
            </section>
        </div>

        <!-- Panduan & Penjelasan Dosen (Accordion / Information Panel) -->
        <section class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
            <h3 class="font-semibold text-slate-800 text-sm mb-2 flex items-center gap-2">
                <i class="fa-solid fa-circle-info text-indigo-600"></i>
                Catatan Penjelasan Operasi Himpunan untuk Demo
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs text-slate-600">
                <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                    <span class="font-semibold text-slate-800 block mb-1">1. Gabungan (Union - ∪)</span>
                    Menggabungkan seluruh anggota dari A dan B. Elemen yang muncul di kedua himpunan hanya ditulis satu kali.
                </div>
                <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                    <span class="font-semibold text-slate-800 block mb-1">2. Irisan (Intersection - ∩)</span>
                    Mengambil elemen-elemen yang **sama-sama dimiliki** oleh Himpunan A dan Himpunan B.
                </div>
                <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                    <span class="font-semibold text-slate-800 block mb-1">3. Selisih (Difference - / −)</span>
                    <code class="font-mono bg-slate-200 px-1 rounded">A - B</code> adalah elemen yang ada di A tetapi TIDAK ada di B. Sebaliknya untuk <code class="font-mono bg-slate-200 px-1 rounded">B - A</code>.
                </div>
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 mt-auto py-4 text-center text-xs text-slate-500">
        <p>Aplikasi Visualisator Himpunan & PIE &bull; Dibuat untuk Demonstrasi Tugas Teori Himpunan & Diskrit</p>
    </footer>

    <!-- JavaScript Logic -->
    <script>
        // Preset Datasets
        const PRESETS = {
            1: {
                title: "Dataset 1: Skill Mahasiswa",
                labelA: "Programming",
                labelB: "Desain Grafis",
                U: ["Budi", "Andi", "Cici", "Doni", "Eka", "Fani", "Gina", "Hadi", "Ira", "Joko"],
                A: ["Budi", "Andi", "Cici", "Doni", "Eka"],
                B: ["Cici", "Doni", "Fani", "Gina"]
            },
            2: {
                title: "Dataset 2: Hobi Olahraga",
                labelA: "Futsal",
                labelB: "Badminton",
                U: ["Ahmad", "Bayu", "Charlie", "Deni", "Erik", "Fahri", "Gilang", "Hery"],
                A: ["Ahmad", "Bayu", "Charlie", "Deni"],
                B: ["Charlie", "Deni", "Erik", "Fahri", "Gilang"]
            },
            3: {
                title: "Dataset 3: Ketersediaan Modul",
                labelA: "Modul Praktikum A",
                labelB: "Modul Praktikum B",
                U: ["M1", "M2", "M3", "M4", "M5", "M6", "M7", "M8", "M9", "M10"],
                A: ["M1", "M2", "M3", "M4", "M5", "M6"],
                B: ["M4", "M5", "M6", "M7", "M8"]
            }
        };

        // State variabel global
        let currentData = {
            U: [],
            A: [],
            B: [],
            labelA: "Himpunan A",
            labelB: "Himpunan B",
            results: {}
        };

        // Inisialisasi saat aplikasi dimuat
        window.onload = function() {
            loadPreset(1);
        };

        // Fungsi memuat preset data
        function loadPreset(id) {
            const data = PRESETS[id];
            if (!data) return;

            document.getElementById('labelA').value = data.labelA;
            document.getElementById('labelB').value = data.labelB;
            document.getElementById('inputU').value = data.U.join(', ');
            document.getElementById('inputA').value = data.A.join(', ');
            document.getElementById('inputB').value = data.B.join(', ');

            processData();
        }

        // Reset Data
        function resetData() {
            document.getElementById('labelA').value = 'Himpunan A';
            document.getElementById('labelB').value = 'Himpunan B';
            document.getElementById('inputU').value = '';
            document.getElementById('inputA').value = '';
            document.getElementById('inputB').value = '';
            processData();
        }

        // Parsing String Input menjadi Array Unik
        function parseInput(inputId) {
            const raw = document.getElementById(inputId).value;
            if (!raw.trim()) return [];
            return Array.from(new Set(
                raw.split(',')
                   .map(item => item.trim())
                   .filter(item => item.length > 0)
            ));
        }

        // Memproses Data dan Operasi Himpunan
        function processData() {
            const rawU = parseInput('inputU');
            let rawA = parseInput('inputA');
            let rawB = parseInput('inputB');

            currentData.labelA = document.getElementById('labelA').value.trim() || 'Himpunan A';
            currentData.labelB = document.getElementById('labelB').value.trim() || 'Himpunan B';

            // Update SVG Labels
            document.getElementById('svgLabelA').textContent = currentData.labelA;
            document.getElementById('svgLabelB').textContent = currentData.labelB;

            // Pastikan U mencakup seluruh anggota A dan B
            const combinedAB = new Set([...rawA, ...rawB]);
            const setU = new Set([...rawU, ...combinedAB]);
            
            currentData.U = Array.from(setU);
            currentData.A = rawA;
            currentData.B = rawB;

            // Sinkronisasi kembali input U jika ada elemen A atau B yang belum ada di U
            if (currentData.U.length !== rawU.length) {
                document.getElementById('inputU').value = currentData.U.join(', ');
            }

            // Hitung Operasi Himpunan
            calculateOperations();

            // Render Hasil ke UI
            renderVennDiagram();
            renderTable();
            renderPIE();

            // Default seleksi reset highlight
            selectOperation('reset');
        }

        // Algoritma Operasi Himpunan
        function calculateOperations() {
            const setA = new Set(currentData.A);
            const setB = new Set(currentData.B);
            const setU = new Set(currentData.U);

            // 1. Union (A ∪ B)
            const union = Array.from(new Set([...currentData.A, ...currentData.B]));

            // 2. Intersection (A ∩ B)
            const intersection = currentData.A.filter(x => setB.has(x));

            // 3. Difference (A - B)
            const A_minus_B = currentData.A.filter(x => !setB.has(x));

            // 4. Difference (B - A)
            const B_minus_A = currentData.B.filter(x => !setA.has(x));

            // 5. Symmetric Difference (A Δ B) = (A - B) ∪ (B - A)
            const sym_diff = [...A_minus_B, ...B_minus_A];

            // 6. Complement A (A') = U - A
            const compl_A = currentData.U.filter(x => !setA.has(x));

            // 7. Complement B (B') = U - B
            const compl_B = currentData.U.filter(x => !setB.has(x));

            // 8. Complement Gabungan (A ∪ B)' = U - (A ∪ B)
            const compl_union = currentData.U.filter(x => !setA.has(x) && !setB.has(x));

            currentData.results = {
                union,
                intersection,
                A_minus_B,
                B_minus_A,
                sym_diff,
                compl_A,
                compl_B,
                compl_union
            };
        }

        // Render Pembagian Elemen ke Diagram Venn SVG
        function renderVennDiagram() {
            const { A_minus_B, intersection, B_minus_A, compl_union } = currentData.results;

            document.getElementById('vennTextA').textContent = A_minus_B.join(', ') || '∅';
            document.getElementById('vennTextAB').textContent = intersection.join(', ') || '∅';
            document.getElementById('vennTextB').textContent = B_minus_A.join(', ') || '∅';
            document.getElementById('vennTextU').textContent = compl_union.length > 0 ? `Luar (A∪B)': ${compl_union.join(', ')}` : 'Luar: ∅';
        }

        // Render Tabel Operasi Himpunan
        function renderTable() {
            const tbody = document.getElementById('operationsTableBody');
            tbody.innerHTML = '';

            document.getElementById('cardinalitySummary').textContent = `|U| = ${currentData.U.length}`;

            const ops = [
                { name: `Himpunan A (${currentData.labelA})`, symbol: 'A', data: currentData.A, color: 'text-blue-600' },
                { name: `Himpunan B (${currentData.labelB})`, symbol: 'B', data: currentData.B, color: 'text-rose-600' },
                { name: 'Gabungan (Union)', symbol: 'A ∪ B', data: currentData.results.union, color: 'text-indigo-600' },
                { name: 'Irisan (Intersection)', symbol: 'A ∩ B', data: currentData.results.intersection, color: 'text-purple-600' },
                { name: 'Selisih A dikurang B', symbol: 'A − B', data: currentData.results.A_minus_B, color: 'text-blue-700' },
                { name: 'Selisih B dikurang A', symbol: 'B − A', data: currentData.results.B_minus_A, color: 'text-rose-700' },
                { name: 'Beda Setara (Beda Simetris)', symbol: 'A Δ B', data: currentData.results.sym_diff, color: 'text-amber-700' },
                { name: 'Komplemen A', symbol: "A'", data: currentData.results.compl_A, color: 'text-slate-600' },
                { name: 'Komplemen B', symbol: "B'", data: currentData.results.compl_B, color: 'text-slate-600' }
            ];

            ops.forEach(op => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50 transition border-b border-slate-100";

                const formattedSet = op.data.length > 0 ? `{ ${op.data.join(', ')} }` : '∅ (Himpunan Kosong)';

                tr.innerHTML = `
                    <td class="py-2.5 px-3 font-medium ${op.color}">${op.name}</td>
                    <td class="py-2.5 px-3 font-bold ${op.color}">${op.symbol}</td>
                    <td class="py-2.5 px-3 text-slate-700 break-all">${formattedSet}</td>
                    <td class="py-2.5 px-3 text-center font-bold text-slate-800">${op.data.length}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        // Render Prinsip Inklusi Eksklusi (PIE)
        function renderPIE() {
            const cardA = currentData.A.length;
            const cardB = currentData.B.length;
            const cardIntersect = currentData.results.intersection.length;
            const cardUnion = currentData.results.union.length;

            document.getElementById('pieCardA').textContent = cardA;
            document.getElementById('pieCardB').textContent = cardB;
            document.getElementById('pieCardIntersect').textContent = cardIntersect;

            // Formulasi Langkah
            const subCalc = `${cardA} + ${cardB} − ${cardIntersect} = ${cardA + cardB - cardIntersect}`;
            document.getElementById('pieStepSubstitution').innerHTML = `
                |A ∪ B| = |A| + |B| − |A ∩ B|<br>
                |A ∪ B| = ${subCalc}
            `;

            // Verifikasi
            const isValid = (cardA + cardB - cardIntersect) === cardUnion;
            const badge = document.getElementById('pieStatusBadge');
            if (isValid) {
                badge.className = "bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-2.5 py-1 rounded-full font-semibold flex items-center gap-1 text-xs";
                badge.innerHTML = `<i class="fa-solid fa-circle-check"></i> Sesuai & Terbukti (|A∪B| = ${cardUnion})`;
            } else {
                badge.className = "bg-rose-500/20 text-rose-300 border border-rose-500/30 px-2.5 py-1 rounded-full font-semibold flex items-center gap-1 text-xs";
                badge.innerHTML = `<i class="fa-solid fa-circle-xmark"></i> Tidak Sesuai`;
            }
        }

        // Soroti Region Diagram Venn Berdasarkan Operasi
        function selectOperation(opKey) {
            const regA = document.getElementById('regionAonly');
            const regInt = document.getElementById('regionIntersect');
            const regB = document.getElementById('regionBonly');
            const badgeText = document.getElementById('activeOpText');

            // Reset Kelas Active
            [regA, regInt, regB].forEach(el => {
                el.classList.remove('active-region');
                el.style.opacity = "0.3";
            });

            if (opKey === 'reset') {
                [regA, regInt, regB].forEach(el => el.style.opacity = "1");
                badgeText.textContent = "Semua Area";
                return;
            }

            switch(opKey) {
                case 'union':
                    regA.style.opacity = "1";
                    regInt.style.opacity = "1";
                    regB.style.opacity = "1";
                    regA.classList.add('active-region');
                    regInt.classList.add('active-region');
                    regB.classList.add('active-region');
                    badgeText.textContent = "Gabungan (A ∪ B)";
                    break;
                case 'intersection':
                    regInt.style.opacity = "1";
                    regInt.classList.add('active-region');
                    badgeText.textContent = "Irisan (A ∩ B)";
                    break;
                case 'A_minus_B':
                    regA.style.opacity = "1";
                    regA.classList.add('active-region');
                    badgeText.textContent = "Selisih (A − B)";
                    break;
                case 'B_minus_A':
                    regB.style.opacity = "1";
                    regB.classList.add('active-region');
                    badgeText.textContent = "Selisih (B − A)";
                    break;
                case 'sym_diff':
                    regA.style.opacity = "1";
                    regB.style.opacity = "1";
                    regA.classList.add('active-region');
                    regB.classList.add('active-region');
                    badgeText.textContent = "Beda Simetris (A Δ B)";
                    break;
                case 'compl_A':
                    regB.style.opacity = "1";
                    regB.classList.add('active-region');
                    badgeText.textContent = "Komplemen A (A') [Abalon luar & B Saja]";
                    break;
                case 'compl_B':
                    regA.style.opacity = "1";
                    regA.classList.add('active-region');
                    badgeText.textContent = "Komplemen B (B') [Abalon luar & A Saja]";
                    break;
            }
        }
    </script>
